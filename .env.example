# Create 2 .env-files:

#--------------.env.development-----------------

NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017
DB_NAME=<DB_name_for_development> 
PORT=<some_port_for_development>


#--------------.env.production------------------

NODE_ENV=production
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
DB_NAME=<DB_name_for_production>
PORT=<some_port_for_production>